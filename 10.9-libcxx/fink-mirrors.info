Info4: <<
Package: fink-mirrors
Version: 0.43.0.1
Revision: 1
Essential: yes
Source: mirror:custom:fink/%n-%v.tar.gz
Source-MD5: 8c4347d367db95d8de965d9ca623fe52
Depends: finx (>= 0.17.3-1)
Replaces: finx (<< 0.17.2-1)
CompileScript: <<
 #!/bin/bash -e
 # 这个包的源码是**上游 tar 包**，里面的路径还是 Fink 时代的：
 #   install.sh        装到 lib/fink/{mirror,URL}
 #   postinstall.pl.in 读 etc/fink.conf
 # 而本仓库的规范是 lib/finx 与 etc/finx.conf（Fink::Config 的 $libpath 就是
 # $basepath/lib/finx）。只改仓库里那份 mirror/ 没有用 —— 构建时用的是 tar 包里
 # 的那一份。所以在这里就地把两处改掉。
 #
 # 不改的话：postinst 找不到 etc/fink.conf 直接退出 2，dpkg 判为失败，
 # 第三阶段从这里断掉，排在后面的 dpkg 与 tar 全都不会安装。
 sed -i '' -e 's|lib/fink|lib/finx|g' \
     -e 's|share/doc/fink/|share/doc/finx/|g' \
     -e 's|share/doc/fink ;|share/doc/finx ;|g' install.sh
 # postinstall.pl 里还有 @PREFIX@/lib/fink/URL/{anonymous-cvs,developer-cvs}，
 # 数据却装在 lib/finx/URL —— 这个改漏了不会报错，只会让 CVS 那两项静默失效。
 sed -e "s|@PREFIX@|%p|g" \
     -e 's|/etc/fink\.conf|/etc/finx.conf|g' \
     -e 's|lib/fink/|lib/finx/|g' \
     < postinstall.pl.in > postinstall.pl
<<
InstallScript: ./install.sh %i
# lib/finx/mirror：上面的 CompileScript 已把上游 tar 里的 lib/fink 改成 lib/finx，
# 与 Fink::Config 的 $libpath 一致。
PostInstScript: %p/lib/finx/mirror/postinstall.pl
#
Description: Mirror infrastructure
DescDetail: <<
The fink-mirrors package keeps a current list of the mirrors which are used 
by finx to download sourcefiles.
<<
