# .cursorignore
# 语法同 .gitignore。列出的路径对 Cursor 完全不可见（不索引、不可读）。
#
# 判定标准只有一条：**读它会不会让人/模型对这份代码产生错误判断。**
# 不是「文件大就忽略」—— 10.9-libcxx/*.patch 也很大，但移植时必须看，所以不忽略。

# ==========================================================
# 生成物：与实际行为无关，且容易与源文件混淆
# ==========================================================
# setup.sh 从 .in 生成。注意**不要**忽略 *.in —— 那才是源文件。
/compiler_wrapper
/compiler_wrapper-10.6
/compiler_wrapper-10.7
/compiler_wrapper-10.9
/g++-wrapper-3.3
/g++-wrapper-4.0
/pathsetup.sh
/postinstall.pl
/shlibs.default
/finx
/finx.8
/finx.conf.5
/finx-dpkg-status-cleanup
/finx-instscripts
/finx-scanpackages
/finx-virtual-pkgs
/dpkg-lockwait
/apt-get-lockwait
/perlmod/Fink.pm
/perlmod/Fink/FinkVersion.pm

# test_setup 造出来的假安装。里面只有一个文件是手写的
# （test/basepath/etc/finx.conf），所以不能整目录忽略。
/test/basepath/bin/
/test/basepath/sbin/
/test/basepath/lib/
/test/basepath/share/
/test/basepath/var/
/test/basepath/src/

# 种子产物
/seed/

# ==========================================================
# 第三方脚本：上游 autoconf / libtool 的整份拷贝
# 约 11000 行，与本项目行为无关；读它们只会淹掉真正的逻辑。
# 它们是 track 的（install.sh 要把它们装进前缀），所以只在 Cursor 里隐藏。
# ==========================================================
/update/config.guess
/update/config.sub
/update/ltconfig
/update/ltmain.sh

# ==========================================================
# 媒体：对话提示音图标，看完文件名就够了
# ==========================================================
/images/*.png

# ==========================================================
# 版本控制与编辑器状态
# ==========================================================
.git/
.DS_Store
*.swp
